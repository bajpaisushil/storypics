# Copy to backend/.env — every value is optional; defaults are shown.

# Image generation: local (this machine) | remote (worker/server.py on another machine you own) | disabled
STORYPIX_GENERATOR=local
STORYPIX_DEVICE=auto                 # auto | mps | cuda | cpu
STORYPIX_PROFILE=auto                # auto → lightning on Apple silicon, quality on CUDA, lcm on CPU-only machines
STORYPIX_LCM_STEPS=4                 # lcm profile (LCM-DreamShaper v7, 512 px): 4–8 steps
STORYPIX_SAFETY_CHECKER=true         # lcm profile: discard images the safety checker flags
STORYPIX_LIGHTNING_STEPS=8           # 4 = faster drafts, 8 = better detail
STORYPIX_IMAGE_RESOLUTION=1024       # 768 ≈ 2x faster and lighter on memory
STORYPIX_PRELOAD_MODELS=false        # load SDXL at startup instead of on the first generation

# Evaluation / automatic retries
STORYPIX_ENABLE_EVALUATOR=true
STORYPIX_AUTO_RETRY=true
STORYPIX_MAX_RETRIES=1
STORYPIX_CANDIDATES_PER_SCENE=1      # >1 = best-of-k (use on a fast GPU)

# Web
STORYPIX_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Allow the Vercel-hosted frontend (and its preview URLs) to talk to this local backend:
# STORYPIX_CORS_ORIGIN_REGEX=https://storypics.*\.vercel\.app
# STORYPIX_ACCESS_KEY=             # optional: require X-StoryPix-Key for generation requests
# STORYPIX_MAX_ACTIVE_JOBS=0       # optional: cap concurrent storybooks (0 = unlimited)

# Remote worker (only with STORYPIX_GENERATOR=remote)
# STORYPIX_REMOTE_GENERATOR_URL=http://192.168.1.20:8001
# STORYPIX_WORKER_TOKEN=change-me
